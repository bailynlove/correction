{
  "name": "correction",
  "version": "0.0.0",
  "description": "A local-first prompt pipeline for coding agents",
  "private": true,
  "type": "module",
  "keywords": [
    "pi-package",
    "prompt-correction",
    "coding-agent"
  ],
  "files": [
    "src/**/*.ts",
    "plugins/correction",
    "CONTEXT.md"
  ],
  "pi": {
    "extensions": [
      "./src/integrations/pi-extension.ts"
    ]
  },
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test 'dist/test/**/*.test.js'",
    "benchmark": "npm run build && node dist/src/benchmark/run-benchmark.js",
    "benchmark:bounded": "npm run build && node dist/src/benchmark/run-bounded-latency.js",
    "benchmark:review": "npm run build && node dist/src/benchmark/prepare-review.js",
    "prototype:risky": "npm run build && node dist/src/prototypes/risky-approval/tui.js",
    "plugin:pi": "npm run build && pi -e dist/src/integrations/pi-extension.js",
    "prototype:codex": "npm run build && node dist/src/vertical-slice/cli.js codex",
    "prototype:codex:demo": "npm run build && node dist/src/vertical-slice/cli.js codex --demo"
  },
  "dependencies": {
    "diff": "9.0.0",
    "smol-toml": "1.7.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "26.2.0",
    "typescript": "7.0.2"
  }
}
